@@ -67,17 +67,17 @@ jobs:
             mingw-w64-ucrt-x86_64-gcc
             mingw-w64-ucrt-x86_64-ninja
 
-      # -static pulls libstdc++/libgcc/winpthread into the exe. OpenMP needs a
-      # second nudge: CMake's FindOpenMP passes libgomp's *import* library by full
-      # path, which beats -static, so point it at the static archive explicitly.
-      # (An earlier commit claimed static linking but never passed these flags.)
+      # Two passes on purpose. Pass 1 is the plain configure that is known to work
+      # (it runs FindOpenMP, whose results are cached). Pass 2 only adds -static,
+      # which pulls libstdc++/libgcc/winpthread into the exes. Putting -static in
+      # pass 1 broke OpenMP detection on newer MSYS2 toolchains. (An earlier commit
+      # claimed static linking but never actually passed any static flag.)
       - name: Configure
         run: |
           cmake -S . -B build -G Ninja \
             -DCMAKE_BUILD_TYPE=Release \
-            -DSTAKMESH_NATIVE_ARCH=OFF \
-            -DCMAKE_EXE_LINKER_FLAGS="-static" \
-            -DOpenMP_gomp_LIBRARY="$(gcc -print-file-name=libgomp.a)"
+            -DSTAKMESH_NATIVE_ARCH=OFF
+          cmake -S . -B build -DCMAKE_EXE_LINKER_FLAGS="-static"
 
       - name: Build
         run: cmake --build build -j
@@ -86,17 +86,40 @@ jobs:
         run: ctest --test-dir build --output-on-failure
 
       # The binaries get copied to machines WITHOUT MSYS2, so a missing-DLL
-      # dependency would only show up later as a silent "won't start". Fail here.
-      - name: Check binaries have no MSYS2 runtime DLL dependency
+      # dependency would only show up later as a silent "won't start".
+      #  - libstdc++/libgcc must be static (that's what -static is for): fail if not.
+      #  - OpenMP (libgomp) stays a DLL (FindOpenMP links its import library), so
+      #    ship libgomp-1.dll and the libwinpthread-1.dll it needs next to the exes.
+      - name: Check runtime DLL dependencies and bundle OpenMP
         run: |
+          BIN_DIR="$(dirname "$(command -v gcc)")"
+          NEED_GOMP=0
           for exe in build/mnist_distributed.exe build/stakmesh_smoke.exe; do
             echo "== $exe imports:"
             objdump -p "$exe" | grep "DLL Name" | sort -u
-            if objdump -p "$exe" | grep -Ei "libstdc|libgcc|winpthread|libgomp"; then
-              echo "::error::$exe still depends on an MSYS2 runtime DLL"
+            if objdump -p "$exe" | grep -Ei "libstdc|libgcc"; then
+              echo "::error::$exe still depends on the MSYS2 C++ runtime (static link failed)"
               exit 1
             fi
+            if objdump -p "$exe" | grep -qi "libgomp"; then NEED_GOMP=1; fi
           done
+          if [ "$NEED_GOMP" = 1 ]; then
+            # Copy libgomp and everything it imports that lives next to gcc
+            # (winpthread, libgcc_s, ...). Windows system DLLs aren't in that
+            # directory, so they are skipped automatically.
+            bundle() {
+              local dll="$1"
+              [ -f "build/$dll" ] && return 0
+              [ -f "$BIN_DIR/$dll" ] || return 0
+              cp -v "$BIN_DIR/$dll" build/
+              for dep in $(objdump -p "$BIN_DIR/$dll" | awk '/DLL Name/{print $3}'); do
+                bundle "$dep"
+              done
+            }
+            bundle libgomp-1.dll
+            echo "== files shipped next to the exes:"
+            ls -1 build/*.dll
+          fi
 
       - name: Upload binaries
         uses: actions/upload-artifact@v4
@@ -105,6 +128,7 @@ jobs:
           path: |
             build/mnist_distributed.exe
             build/stakmesh_smoke.exe
+            build/*.dll
           if-no-files-found: error
 
   # Only runs when a GitHub Release is created (e.g. `git tag vX && git push
@@ -129,4 +153,5 @@ jobs:
